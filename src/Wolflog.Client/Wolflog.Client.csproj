<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Wolflog.Client</RootNamespace>
    <PackageId>Wolflog.Client</PackageId>
    <Description>Envoie les logs, traces, métriques et crashs d'une application .NET vers un serveur Wolflog. Une ligne : builder.AddWolflog();</Description>
    <PackageTags>observability;logging;tracing;metrics;opentelemetry;crash</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Condition="'$(TargetFramework)' == 'net8.0'" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Wolflog.Protocol\Wolflog.Protocol.csproj" />
    <InternalsVisibleTo Include="Wolflog.Tests" />
    <InternalsVisibleTo Include="Wolflog.Client.Serilog" />
    <InternalsVisibleTo Include="Wolflog.Client.Profiling" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>
</Project>
