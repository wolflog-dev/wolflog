{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Web": { "Url": "http://0.0.0.0:5080", "Protocols": "Http1" },
      "OtlpHttp": { "Url": "http://0.0.0.0:4318", "Protocols": "Http1" },
      "OtlpGrpc": { "Url": "http://0.0.0.0:4317", "Protocols": "Http2" }
    },
    "Limits": { "MaxRequestBodySize": 67108864 }
  },
  "Vigil": {
    "DataDirectory": "",
    "Auth": {
      "Enabled": true,
      "AdminUser": "admin",
      "AdminPassword": "",
      "ApiKeys": []
    },
    "Storage": {
      "FlushIntervalSeconds": 60,
      "FlushRows": 100000,
      "FsyncWal": false,
      "MemoryLimit": "",
      "Threads": 0
    },
    "Retention": {
      "LogsDays": 14,
      "TracesDays": 7,
      "MetricsDays": 30,
      "MaxDiskGb": 0
    }
  }
}
