<?xml version="1.0" encoding="utf-8"?>
<!-- Utilisé uniquement sous IIS (ignoré par systemd, Docker et le service Windows). -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\wolflog.exe" arguments="" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!-- Le live tail (Server-Sent Events) ne doit pas être mis en tampon par la compression IIS. -->
      <urlCompression doStaticCompression="false" doDynamicCompression="false" />
      <security>
        <requestFiltering>
          <!-- Lots OTLP jusqu'à 64 Mo -->
          <requestLimits maxAllowedContentLength="67108864" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
