<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Wolflog.Server</RootNamespace>
    <AssemblyName>wolflog</AssemblyName>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <UserSecretsId>wolflog-server</UserSecretsId>
    <!-- Dossier de l'UI Angular -->
    <UiDir>$(MSBuildThisFileDirectory)..\..\ui\</UiDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data.Full" />
    <PackageReference Include="Grpc.AspNetCore.Server" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" />
    <PackageReference Include="Novell.Directory.Ldap.NETStandard" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wolflog.Protocol\Wolflog.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wolflog.Tests" />
  </ItemGroup>

  <!-- L'UI est embarquée dans le binaire : un seul fichier à déployer. -->
  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" />
    <EmbeddedResource Include="Rum/wolflog-rum.js" LogicalName="wolflog-rum.js" />
    <EmbeddedResource Include="Rum/wolflog-heatmap.js" LogicalName="wolflog-heatmap.js" />
  </ItemGroup>

  <!-- Construit l'UI Angular avant une publication (désactivable avec -p:SkipUi=true). -->
  <Target Name="BuildWolflogUi" BeforeTargets="PrepareForPublish" Condition="'$(SkipUi)' != 'true' And Exists('$(UiDir)package.json')">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(UiDir)" Condition="!Exists('$(UiDir)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(UiDir)" />
    <ItemGroup>
      <EmbeddedResource Include="wwwroot\**" Exclude="@(EmbeddedResource)" />
    </ItemGroup>
  </Target>
  <!--
    Archive autonome (IIS, service Windows, Linux) : elle embarque le runtime .NET du SDK qui la produit. En dessous de
    10.0.14, ce runtime contient le défaut du décodeur Brotli CVE-2026-111497 (« Node2Shell ») et les défauts de Kestrel
    corrigés en 10.0.13 : la publication est refusée plutôt que de livrer un serveur vulnérable.
  -->
  <PropertyGroup>
    <MinimumBundledRuntime>10.0.14</MinimumBundledRuntime>
  </PropertyGroup>
  <Target Name="CheckBundledRuntime" BeforeTargets="PrepareForPublish" Condition="'$(SelfContained)' == 'true'">
    <PropertyGroup>
      <_BundledRuntime>$([System.Text.RegularExpressions.Regex]::Match('$(BundledNETCoreAppPackageVersion)', '^\d+\.\d+\.\d+').Value)</_BundledRuntime>
    </PropertyGroup>
    <Error Condition="'$(_BundledRuntime)' == '' Or $([System.Version]::Parse('$(_BundledRuntime)').CompareTo($([System.Version]::Parse('$(MinimumBundledRuntime)')))) &lt; 0"
           Text="Runtime .NET embarqué $(BundledNETCoreAppPackageVersion) : $(MinimumBundledRuntime) ou plus récent requis (correctifs de sécurité). Installez le SDK .NET 10 le plus récent." />
  </Target>
</Project>
