root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,slnx,xml}]
indent_size = 2

[*.{ts,html,scss,js}]
indent_size = 2

[*.sh]
end_of_line = lf

[*.cs]
# Organisation : espaces de noms "file-scoped", using System en premier.
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# using inutile (les espaces de noms communs sont dans GlobalUsings.cs de chaque projet).
dotnet_diagnostic.IDE0005.severity = warning
# Espace de noms en bloc au lieu de "file-scoped".
dotnet_diagnostic.IDE0161.severity = warning

# Style
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion

# Nommage : champs statiques en PascalCase, autres champs privés en _camelCase (première règle applicable).
dotnet_naming_rule.static_fields.symbols = static_fields
dotnet_naming_rule.static_fields.style = pascal
dotnet_naming_rule.static_fields.severity = suggestion
dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.required_modifiers = static
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# Code généré (protobuf) : non concerné.
[**/obj/**.cs]
generated_code = true
