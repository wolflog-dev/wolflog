<Project>
  <PropertyGroup>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <Authors>Wolflog contributors</Authors>
    <Product>Wolflog</Product>
    <Description>Wolflog - observabilité tout-en-un (logs, traces, métriques, crashs) pour .NET.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)docs/icon.png" Condition="Exists('$(MSBuildThisFileDirectory)docs/icon.png')" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
