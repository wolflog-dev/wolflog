<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <!-- Comme le serveur en production : aucune culture installée. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Wolflog.Server\Wolflog.Server.csproj" />
    <ProjectReference Include="..\..\src\Wolflog.Client\Wolflog.Client.csproj" />
    <ProjectReference Include="..\..\src\Wolflog.Client.Serilog\Wolflog.Client.Serilog.csproj" />
    <ProjectReference Include="..\..\src\Wolflog.Client.Profiling\Wolflog.Client.Profiling.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
